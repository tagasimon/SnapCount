# Which models the server offers. Free, self-hosted: owlv2, grounding_dino, omdet_turbo.
# claude needs ANTHROPIC_API_KEY (paid). mock always answers 12 (testing only).
SNAPCOUNT_MODELS=owlv2,grounding_dino,omdet_turbo,claude

# Which models "Auto" runs and combines.
AUTO_MODELS=owlv2,grounding_dino,omdet_turbo

# Load the free models at startup so the first count isn't slow (1 = yes).
PRELOAD_MODELS=1

# Optional: only needed for the paid Claude model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional but recommended once deployed: a long random string. Put the same value in Config.swift.
APP_TOKEN=

# Optional tuning
# DETECT_TILED=1            # also look at zoomed-in tiles: ~5x slower, sometimes better on dense piles
# OWLV2_THRESHOLD=0.15      # per-model score cut-off; lower = counts more (and more false hits)
# GROUNDING_DINO_THRESHOLD=0.15
# OMDET_TURBO_THRESHOLD=0.10
# TORCH_DEVICE=cpu          # force cpu / mps / cuda
MAX_UPLOAD_MB=10
MAX_IMAGE_SIDE=1600
AI_TIMEOUT_SECONDS=60
PRICE_IN_PER_MTOK=2
PRICE_OUT_PER_MTOK=10
